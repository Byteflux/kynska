{
  "name": "kynska",
  "version": "0.1.0",
  "private": true,
  "description": "Docs, skills and tooling for agents that make music with Strudel",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kynska": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:examples": "node scripts/check-examples.ts",
    "check:docs": "node scripts/check-docs.ts",
    "evals": "node evals/run.ts",
    "link-strudel": "node scripts/link-strudel.ts",
    "postinstall": "node scripts/link-strudel.ts"
  },
  "dependencies": {
    "@kabelsalat/lib": "0.4.1",
    "@kabelsalat/web": "0.4.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tonaljs/tonal": "4.10.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "chord-voicings": "0.0.1",
    "escodegen": "2.1.0",
    "estree-walker": "3.0.3",
    "fraction.js": "5.2.1",
    "jsdoc": "4.0.5",
    "nanostores": "0.11.3",
    "node-web-audio-api": "2.2.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "vite": "8.3.5",
    "web-tree-sitter": "0.24.7",
    "webmidi": "3.1.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "mdast-util-mdx": "^3.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
